# Copy to .env.local (gitignored) and fill in. All values here are public
# (publishable key + API host) — secrets never live in the mobile app.

# Clerk publishable key — same instance as V200 (pk_test locally, pk_live prod).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Backend base URL. iOS simulator reaches the Mac's localhost directly.
# Physical device: use your Mac's LAN IP (e.g. http://192.168.x.x:3000).
# Production: https://app.minds-shift.com
EXPO_PUBLIC_API_URL=http://localhost:3000
